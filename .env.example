# Copy to .env.local for local dev, or set these in Railway's Variables.
# The app reads all secrets from the environment — never hard-coded.

# Postgres connection string. On Railway this is provided automatically when you
# add a PostgreSQL database to the project.
DATABASE_URL=postgres://user:pass@localhost:5432/ryze

# The single password used to log into the app.
APP_PASSWORD=change-me

# Secret used to sign the login session cookie. Any long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Secret the scheduler must send to trigger automatic checks (set later).
CRON_SECRET=another-long-random-string

# Integration keys (added when we wire up fetching).
YOUTUBE_API_KEY=
APIFY_TOKEN=
